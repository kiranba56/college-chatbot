# College Chatbot Configuration
# Copy this file to .env and fill in your actual credentials

COLLEGE_NAME="National Institute of Science & Technology"
COLLEGE_SHORT_NAME="NIST Campus AI"
PORT=5000
DEBUG=True

# =========================================================================
# 1. Supabase Database Configuration (Optional - Local Vector fallback active if empty)
# Get these from: Supabase Dashboard -> Project Settings -> API
# =========================================================================
SUPABASE_URL=
SUPABASE_KEY=

# =========================================================================
# 2. AI / LLM Configuration
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# =========================================================================
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_LLM_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if you prefer OpenAI over Gemini)
OPENAI_API_KEY=
